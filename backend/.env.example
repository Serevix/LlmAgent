DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/llm_learning
JWT_SECRET_KEY=replace-with-a-long-random-secret
GuiJiLiuDong_API_KEY=
GuiJiLiuDong_BASE_URL=https://api.siliconflow.cn/v1
# 配置官方 Key 后，前端自动显示 DeepSeek 官方选项；Key 不发送给前端。
DeepSeeK_API_KEY=
DeepSeek_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-flash
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=llm_book_chunks_bge_m3
# 新混合集合/别名；旧集合保留为迁移来源。升级前先停后端，执行 python -m app.rag.migrate_index。
MILVUS_HYBRID_COLLECTION=llm_book_chunks_bge_m3_hybrid
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RAG_MIN_SCORE=0.55
# dense 基线 / hybrid（BM25+向量+RRF）/ hybrid_rerank（默认，另加硅基流动重排）
RAG_RETRIEVAL_MODE=hybrid_rerank
RAG_RECALL_K=20
RAG_FUSION_K=40
RAG_RRF_K=60
RAG_RERANK_MAX_CANDIDATES=64
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 留空时沿用硅基流动地址/Key；与用户选择的聊天模型配置无关。
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_TIMEOUT=25
# 重排初始阈值，需用实际书籍正反例校准；不是沿用余弦的 0.55。
RERANK_MIN_SCORE=0.30
# 图片工具使用独立的图片模型；Key 和地址留空时沿用硅基流动配置。
IMAGE_MODEL=Kwai-Kolors/Kolors
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_TIMEOUT=120
IMAGE_MAX_BYTES=10485760
# 可信图片存储域名；仅在服务商更换正式下载域名后调整。
IMAGE_DOWNLOAD_HOSTS=*.siliconflow.cn,*.siliconflow.com,sc-maas.oss-cn-shanghai.aliyuncs.com
# 生成文件默认保存在 backend/data/generated，无需额外配置 ARTIFACT_STORAGE_DIR。
CHAT_MODEL=openai:deepseek-ai/deepseek-v4-flash
# 可选：逗号分隔的额外模型预设，使用同一个 SiliconFlow API Key。
CHAT_MODEL_OPTIONS=
# 默认跳过独立问题的改写，含指代的追问仍使用摘要和近期消息补全。
CHAT_QUERY_REWRITE_MODE=auto
# 普通知识问答不调用记忆模型；明确的偏好/目标等信息仍交给模型判断是否保存。
CHAT_MEMORY_MODE=selective
# 可选：独立的模型密钥加密秘密；留空时从 JWT_SECRET_KEY 派生。更换后旧配置需重新添加。
MODEL_CREDENTIAL_SECRET=
# 上下文预算；必须不超过所选服务商模型的真实窗口。输入计数采用保守估计。
CHAT_CONTEXT_WINDOW_TOKENS=32768
CHAT_MAX_OUTPUT_TOKENS=2048
CONTEXT_SAFETY_MARGIN_TOKENS=1024
CONTEXT_HISTORY_BUDGET_TOKENS=6000
CONTEXT_SUMMARY_TRIGGER_TOKENS=6000
CONTEXT_RECENT_MESSAGES=8
CONTEXT_SUMMARY_MAX_TOKENS=1800
CONTEXT_SUMMARY_BATCH_TOKENS=6000
CONTEXT_AUX_MAX_OUTPUT_TOKENS=512
RAG_CONTEXT_BUDGET_TOKENS=12000
